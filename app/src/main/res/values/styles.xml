<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BaseTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="BaseTheme.MaterialComponents" parent="@style/Theme.MaterialComponents.Light.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/usedesk_black_2</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--Adaptive Padding Start-->
    <style name="Custom.Chat.Message.Text.Container4" parent="Usedesk.Chat.Message.Text.Container4">
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Custom.Chat.Message.Text.Client" parent="Usedesk.Chat.Message.Text.Client">
        <item name="usedesk_common_container_4">@style/Custom.Chat.Message.Text.Container4</item>
    </style>

    <style name="Custom.Chat.Message.Text.Agent" parent="Usedesk.Chat.Message.Text.Agent">
        <item name="usedesk_common_container_4">@style/Custom.Chat.Message.Text.Container4</item>
    </style>
    <!--Adaptive Padding End-->

    <style name="Custom.Chat.Message.Feedback.Good.Image" parent="Usedesk.Chat.Message.Feedback.Good.Image">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">4dp</item>
        <item name="usedesk_drawable_1">@drawable/usedesk_ic_star_outline</item>
        <item name="usedesk_drawable_2">@drawable/usedesk_ic_star_filled</item>
    </style>

    <style name="Custom.Chat.Message.Feedback.Bad.Image" parent="Usedesk.Chat.Message.Feedback.Bad.Image">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">4dp</item>
        <item name="usedesk_drawable_1">@drawable/usedesk_ic_star_outline</item>
        <item name="usedesk_drawable_2">@drawable/usedesk_ic_star_filled</item>
    </style>

    <style name="Custom.Chat.Message.Feedback.Star.Image" parent="Usedesk.Chat.Message.Feedback.Star.Image">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:padding">3dp</item>
        <item name="usedesk_drawable_1">@drawable/usedesk_ic_smile_sad</item>
        <item name="usedesk_drawable_2">@drawable/usedesk_ic_smile_happy_colored</item>
    </style>

    <style name="Custom.Chat.Message.Text.Agent.Rating" parent="Usedesk.Chat.Message.Text.Agent">
        <item name="usedesk_chat_message_feedback_good_image">@style/Custom.Chat.Message.Feedback.Good.Image</item>
        <item name="usedesk_chat_message_feedback_bad_image">@style/Custom.Chat.Message.Feedback.Bad.Image</item>
        <item name="usedesk_chat_message_feedback_star_image">@style/Custom.Chat.Message.Feedback.Star.Image</item>
    </style>

    <style name="Custom.Chat.Message.Text.Agent.AdaptiveRating" parent="Custom.Chat.Message.Text.Agent.Rating">
        <item name="usedesk_common_container_4">@style/Custom.Chat.Message.Text.Container4</item>
    </style>

    <style name="CustomShapeAppearanceBottomSheetDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="Custom.Chat.FormSelector.Dialog.Style" parent="Usedesk.Common.BottomSheetDialog.Style">
        <item name="shapeAppearanceOverlay">@style/CustomShapeAppearanceBottomSheetDialog</item>
    </style>

    <style name="Custom.Chat.FormSelector.Dialog" parent="Usedesk.Chat.FormSelector.Dialog">
        <item name="bottomSheetStyle">@style/Custom.Chat.FormSelector.Dialog.Style</item>
    </style>

    <style name="Custom.Chat.Attachment.Dialog.Style" parent="Usedesk.Common.BottomSheetDialog.Style">
        <item name="shapeAppearanceOverlay">@style/CustomShapeAppearanceBottomSheetDialog</item>
    </style>

    <style name="Custom.Chat.Attachment.Dialog" parent="Usedesk.Chat.Attachment.Dialog">
        <item name="bottomSheetStyle">@style/Custom.Chat.Attachment.Dialog.Style</item>
    </style>

</resources>
